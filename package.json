    "test:e2e:wo:put": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/work.order.put.test.ts",
    "test:e2e:wo:release": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --forceExit --runInBand --runTestsByPath ./test/e2e/work.order.release.test.ts",
